{
 "title": "Export Classification Check",
 "uid": "ecc",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "End-to-end run latency p50 / p95 (submission -> result); SLO p95 <= 20 s",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(ecc_run_duration_seconds_bucket[2m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(ecc_run_duration_seconds_bucket[2m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "20",
     "legendFormat": "SLO",
     "refId": "C"
    }
   ]
  },
  {
   "id": 2,
   "title": "Throughput (finished runs / s)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(ecc_runs_total[1m]))",
     "legendFormat": "runs/s",
     "refId": "A"
    },
    {
     "expr": "sum(rate(ecc_runs_total{status=\"failed\"}[1m]))",
     "legendFormat": "failed/s",
     "refId": "B"
    }
   ]
  },
  {
   "id": 3,
   "title": "Availability (targets up)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "avg(up{job=~\"api|worker\"})",
     "legendFormat": "up ratio",
     "refId": "A"
    }
   ]
  },
  {
   "id": 4,
   "title": "API latency p50 / p95",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, sum(rate(ecc_http_request_duration_seconds_bucket[2m])) by (le))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.95, sum(rate(ecc_http_request_duration_seconds_bucket[2m])) by (le))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ]
  },
  {
   "id": 5,
   "title": "API error rate (5xx / all)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(ecc_http_requests_total{status=~\"5..\"}[1m])) / sum(rate(ecc_http_requests_total[1m]))",
     "legendFormat": "5xx ratio",
     "refId": "A"
    }
   ]
  },
  {
   "id": 6,
   "title": "Quarantined / rate-limited / cache hits",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(ecc_quarantined_total[5m]))",
     "legendFormat": "quarantined/s",
     "refId": "A"
    },
    {
     "expr": "rate(ecc_rate_limited_total[5m])",
     "legendFormat": "429/s",
     "refId": "B"
    },
    {
     "expr": "sum(rate(ecc_cache_events_total{kind=\"run\",result=\"hit\"}[5m]))",
     "legendFormat": "run-cache hits/s",
     "refId": "C"
    }
   ]
  },
  {
   "id": 7,
   "title": "Task success rate per agent",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (agent)(rate(ecc_agent_tasks_total{outcome=\"success\"}[5m])) / sum by (agent)(rate(ecc_agent_tasks_total[5m]))",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 8,
   "title": "Steps per run (mean) per agent",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (agent)(rate(ecc_agent_steps_per_run_sum[5m])) / sum by (agent)(rate(ecc_agent_steps_per_run_count[5m]))",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 9,
   "title": "Tool calls per run (mean) per agent",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (agent)(rate(ecc_agent_tool_calls_per_run_sum[5m])) / sum by (agent)(rate(ecc_agent_tool_calls_per_run_count[5m]))",
     "legendFormat": "{{agent}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 10,
   "title": "Latency per step, p95 (LLM decide / tools)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, agent, kind)(rate(ecc_step_duration_seconds_bucket[2m])))",
     "legendFormat": "{{agent}} {{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 11,
   "title": "LLM retry rate and breaker state (0 closed, 1 half-open, 2 open)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rate(ecc_llm_retries_total[2m])",
     "legendFormat": "retries/s {{instance}}",
     "refId": "A"
    },
    {
     "expr": "max(ecc_llm_breaker_state)",
     "legendFormat": "breaker",
     "refId": "B"
    }
   ]
  },
  {
   "id": 12,
   "title": "Verification outcomes / degraded runs",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 21,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (outcome)(rate(ecc_verification_total[5m]))",
     "legendFormat": "verify {{outcome}}",
     "refId": "A"
    },
    {
     "expr": "sum by (reason)(rate(ecc_degraded_runs_total[5m]))",
     "legendFormat": "degraded {{reason}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 13,
   "title": "LLM cost per step (USD/s)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (step)(rate(ecc_llm_cost_usd_total[5m]))",
     "legendFormat": "{{step}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 14,
   "title": "Tokens/s by kind",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (kind)(rate(ecc_llm_tokens_total[5m]))",
     "legendFormat": "{{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 15,
   "title": "Live-sampled quality (rolling mean of latest scored runs)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "ecc_quality_score",
     "legendFormat": "{{metric}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 16,
   "title": "CPU per container (cores)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (name)(rate(container_cpu_usage_seconds_total{name=~\".+\"}[1m]))",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 17,
   "title": "Memory per container",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (name)(container_memory_working_set_bytes{name=~\".+\"})",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 18,
   "title": "Container uptime",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 35,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "time() - container_start_time_seconds{name=~\".+\"}",
     "legendFormat": "{{name}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 19,
   "title": "Corpus: chunks / documents / official ratio",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 42,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "ecc_corpus_chunks",
     "legendFormat": "chunks",
     "refId": "A"
    },
    {
     "expr": "ecc_corpus_documents",
     "legendFormat": "documents",
     "refId": "B"
    },
    {
     "expr": "ecc_corpus_official_chunk_ratio",
     "legendFormat": "official ratio",
     "refId": "C"
    }
   ]
  },
  {
   "id": 20,
   "title": "Corpus age (s since index build)",
   "type": "timeseries",
   "datasource": {
