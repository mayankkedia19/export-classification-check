     "refId": "A"
    }
   ]
  },
  {
   "id": 21,
   "title": "Ingestion throughput (chunks embedded / s)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 42,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
