# Copy to .env and edit. Placeholders only: no real secrets belong in the repository.
APP_ENV=dev
LOG_LEVEL=INFO

# --- Postgres (docker compose) ---
POSTGRES_USER=ecc
POSTGRES_DB=ecc
POSTGRES_PASSWORD=change-me-local-only

# --- Admin / API protection ---
# Required for /v1/quarantine and /admin/* when APP_ENV is not dev
ADMIN_API_KEY=change-me
# Comma-separated; when set, X-API-Key is required on the public endpoints
API_KEYS=

# --- LLM provider (any OpenAI-compatible endpoint; set by configuration only) ---
# The compose default points at the bundled stub-llm service (deterministic, no cost).
# openai_compatible -> your provider (free tier or a local runtime)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://stub-llm:8001/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.4
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RESET_S=15
# Prices in USD per 1000 tokens, used for per-step cost attribution (set to your provider's price list)
PRICE_PROMPT_PER_1K=0.0005
PRICE_COMPLETION_PER_1K=0.0015
# Stub service latency
STUB_DELAY_MS=600
STUB_JITTER_MS=200

# --- Agent loop bounds ---
MAX_AGENT_STEPS=12
MAX_TOOL_CALLS=30
RUN_TIMEOUT_S=60
TOOL_TIMEOUT_S=5
MAX_RESEARCH_ATTEMPTS=3
PROMPT_VERSION=v2
RETRIEVAL_MODE=hybrid

# --- Embeddings: leave EMBEDDING_MODEL empty to use the local hashing fallback ---
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=

# --- Cache / rate limit / sampling ---
CACHE_TTL_S=3600
RUN_CACHE_ENABLED=true
RATE_LIMIT_PER_MIN=30
LIVE_SCORE_SAMPLE_RATE=0.25

# --- Observability ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
WORKER_CONCURRENCY=4
